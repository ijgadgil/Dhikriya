[flake8]
max-line-length = 130
exclude = build,install,log,src/*/setup.py
per-file-ignores = src/cogndn_bringup/launch/*.py:E127 src/cogndn_core/cogndn_core/context.py:E127
# ROS 2 installs extra flake8 plugins (docstrings, import-order, quotes, builtins, comprehensions).
# They are style preferences only; the project checks real errors (E, W, F).
extend-ignore = D, I1, I2, Q0, A003, C4
