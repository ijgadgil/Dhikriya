<?xml version="1.0"?>
<sdf version="1.9">
  <model name="traffic_car_blue">
    <!-- +x is the front of the car. The Prius meshes are modelled along -y, hence the link yaw. -->
    <link name="body">
      <pose>0 0 0 0 0 1.5708</pose>
      <inertial><pose>0 0 0.6 0 0 0</pose><mass>1200</mass>
        <inertia><ixx>800</ixx><iyy>300</iyy><izz>900</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="c"><pose>0 0 0.75 0 0 0</pose><geometry><box><size>1.75 4.5 1.4</size></box></geometry>
        <surface><friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction></surface></collision>
      <visual name="body"><geometry><mesh><scale>0.01 0.01 0.01</scale><uri>model://prius_vla/meshes/hybrid_body.obj</uri></mesh></geometry><material><diffuse>0.05 0.2 0.65 1</diffuse><ambient>0.05 0.2 0.65 1</ambient><specular>0.6 0.6 0.6 1</specular></material></visual>
      <visual name="w_fl"><pose>0.767 -1.41 0.3 0 0 0</pose><geometry><mesh><scale>0.01 0.01 0.01</scale><uri>model://prius_vla/meshes/wheel.obj</uri></mesh></geometry></visual>
      <visual name="w_fr"><pose>-0.767 -1.41 0.3 0 0 0</pose><geometry><mesh><scale>0.01 0.01 0.01</scale><uri>model://prius_vla/meshes/wheel.obj</uri></mesh></geometry></visual>
      <visual name="w_rl"><pose>0.793 1.45 0.3 0 0 0</pose><geometry><mesh><scale>0.01 0.01 0.01</scale><uri>model://prius_vla/meshes/wheel.obj</uri></mesh></geometry></visual>
      <visual name="w_rr"><pose>-0.793 1.45 0.3 0 0 0</pose><geometry><mesh><scale>0.01 0.01 0.01</scale><uri>model://prius_vla/meshes/wheel.obj</uri></mesh></geometry></visual>
    </link>
  </model>
</sdf>
