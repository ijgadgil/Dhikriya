<mxfile host="app.diagrams.net"><diagram name="Increment roadmap" id="d1"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="330"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p0" value="&lt;b&gt;Phase 0: Foundation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;msgs · config · C1 core&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Redis iface · ledger · CI&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="230" height="150" as="geometry"/></mxCell><mxCell id="p1" value="&lt;b&gt;Phase 1: Cognition&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;VLA on llava-phi3&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;schema output · bake-off&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="282" y="70" width="230" height="150" as="geometry"/></mxCell><mxCell id="p2" value="&lt;b&gt;Phase 2: NDN plane&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;NDNd ×2 · netem · signed&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;producers · consumer&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="544" y="70" width="230" height="150" as="geometry"/></mxCell><mxCell id="p3" value="&lt;b&gt;Phase 3: Driving&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;planner · tracker&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;LiDAR safety envelope&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="806" y="70" width="230" height="150" as="geometry"/></mxCell><mxCell id="p4" value="&lt;b&gt;Phase 4: Novelty loop&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;C1 → NDN → C2&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;C3 explanations&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1068" y="70" width="230" height="150" as="geometry"/></mxCell><mxCell id="p5" value="&lt;b&gt;Phase 5: Evaluation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;baselines · 30-run&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;stats · figures&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1330" y="70" width="230" height="150" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2.4;endArrow=block;endFill=1;fontColor=#333333;fontStyle=2;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="250" y="145" as="sourcePoint"/><mxPoint x="282" y="145" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2.4;endArrow=block;endFill=1;fontColor=#333333;fontStyle=2;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="512" y="145" as="sourcePoint"/><mxPoint x="544" y="145" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2.4;endArrow=block;endFill=1;fontColor=#333333;fontStyle=2;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="774" y="145" as="sourcePoint"/><mxPoint x="806" y="145" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2.4;endArrow=block;endFil